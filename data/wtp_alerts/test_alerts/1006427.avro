ise"}, {"type": ["float", "null"], "name": "tmdist2", "default": null, "doc": "Distance to second closest source from 2MASS catalog; if exists within 60 arcsec [arcsec]; defaults to 6.0 otherwise"}, {"type": ["float", "null"], "name": "tmdist3", "default": null, "doc": "Distance to third closest source from 2MASS catalog; if exists within 60 arcsec [arcsec]; defaults to 6.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagj1", "default": null, "doc": "J-band PSF-fit magnitude of closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagj2", "default": null, "doc": "J-band PSF-fit magnitude of second closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagj3", "default": null, "doc": "J-band PSF-fit magnitude of third closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagh1", "default": null, "doc": "H-band PSF-fit magnitude of closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagh2", "default": null, "doc": "H-band PSF-fit magnitude of second closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagh3", "default": null, "doc": "H-band PSF-fit magnitude of third closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagk1", "default": null, "doc": "Ks-band PSF-fit magnitude of closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagk2", "default": null, "doc": "Ks-band PSF-fit magnitude of second closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 9