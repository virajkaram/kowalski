Objavro.codecnullavro.schemažè{"type": "record", "version": "0.1", "name": "alert", "namespace": "wtp", "fields": [{"type": "string", "name": "schemavsn", "doc": "schema version used"}, {"type": "string", "name": "publisher", "doc": "origin of alert packet"}, {"type": "bytes", "name": "cutoutScience", "doc": "science cutout image [gzipped fits bytestream]"}, {"type": "bytes", "name": "cutoutTemplate", "doc": "cutout of template image [gzipped fits bytestream]"}, {"type": "bytes", "name": "cutoutDifference", "doc": "difference image cutout [gzipped fits bytestream]"}, {"type": "string", "name": "objectId"}, {"type": "long", "name": "candid"}, {"type": {"type": "record", "version": "0.1", "name": "candidate", "namespace": "wtp.alert", "fields": [{"type": "double", "name": "mjd", "doc": "Observation Modified Julian date at start of exposure [days]"}, {"type": "long", "name": "stackid", "doc": "Processing ID for science image to facilitate archive retrieval"}, {"type": "long", "name": "subid", "doc": "Processing ID for difference image to facilitate archive retrieval"}, {"type": ["float", "null"], "name": "diffmaglim", "default": null, "doc": "Expected 5-sigma mag limit in difference image based on global noise estimate [mag]"}, {"type": ["string", "null"], "name": "pdiffimfilename", "default": null, "doc": "filename of positive (sci minus ref) difference image"}, {"type": "long", "name": "candid", "doc": "Candidate ID from operations DB"}, {"type": "string", "name": "isdiffpos", "doc": "t or 1 => candidate is from positive (sci minus ref) subtraction; f or 0 => candidate is from negative (ref minus sci) subtraction"}, {"type": ["int", "null"], "name": "epochid", "default": null, "doc": "Epoch ID"}, {"type": ["int", "null"], "name": "bandid", "default": null, "doc": "Band ID [1 for W1, 2 for W2]"}, {"type": ["int", "null"], "name": "field", "default": null, "doc": "WTP field ID"}, {"type": ["float", "null"], "name": "xpos", "default": null, "doc": "x-image position of candidate [pixels]"}, {"type": ["float", "null"], "name": "ypos", "default": null, "doc": "y-image position of candidate [pixels]"}, {"type": "double", "name": "ra", "doc": "Right Ascension of candidate; J2000 [deg]"}, {"type": "double", "name": "dec", "doc": "Declination of candidate; J2000 [deg]"}, {"type": "float", "name": "fluxpsf", "doc": "Flux from PSF-fit photometry [counts]"}, {"type": "float", "name": "sigmafluxpsf", "doc": "1-sigma uncertainty in fluxpsf [counts]"}, {"type": "float", "name": "magpsf", "doc": "Magnitude from PSF-fit photometry [mag]"}, {"type": "float", "name": "sigmapsf", "doc": "1-sigma uncertainty in magpsf [mag]"}, {"type": ["float", "null"], "name": "chipsf", "default": null, "doc": "Reduced chi-square for PSF-fit"}, {"type": ["float", "null"], "name": "magap", "default": null, "doc": "Aperture mag using 4 pixel diameter aperture [mag]"}, {"type": ["float", "null"], "name": "sigmagap", "default": null, "doc": "1-sigma uncertainty in magap [mag]"}, {"type": ["float", "null"], "name": "fwhm", "default": null, "doc": "Full Width Half Max assuming a Gaussian core, from SExtractor [pixels]"}, {"type": ["float", "null"], "name": "aimage", "default": null, "doc": "Windowed profile RMS afloat major axis from SExtractor [pixels]"}, {"type": ["float", "null"], "name": "bimage", "default": null, "doc": "Windowed profile RMS afloat minor axis from SExtractor [pixels]"}, {"type": ["float", "null"], "name": "elong", "default": null, "doc": "Ratio: aimage / bimage"}, {"type": ["int", "null"], "name": "nneg", "default": null, "doc": "number of negative pixels in a 5 x 5 pixel stamp"}, {"type": ["float", "null"], "name": "sumrat", "default": null, "doc": "Ratio: sum(pixels) / sum(|pixels|) in a 5 x 5 pixel stamp where stamp is first median-filtered to mitigate outliers"}, {"type": ["float", "null"], "name": "tmdist1", "default": null, "doc": "Distance to closest source from 2MASS catalog; if exists within 60 arcsec [arcsec]; defaults to 6.0 otherwise"}, {"type": ["float", "null"], "name": "tmdist2", "default": null, "doc": "Distance to second closest source from 2MASS catalog; if exists within 60 arcsec [arcsec]; defaults to 6.0 otherwise"}, {"type": ["float", "null"], "name": "tmdist3", "default": null, "doc": "Distance to third closest source from 2MASS catalog; if exists within 60 arcsec [arcsec]; defaults to 6.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagj1", "default": null, "doc": "J-band PSF-fit magnitude of closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagj2", "default": null, "doc": "J-band PSF-fit magnitude of second closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagj3", "default": null, "doc": "J-band PSF-fit magnitude of third closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagh1", "default": null, "doc": "H-band PSF-fit magnitude of closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagh2", "default": null, "doc": "H-band PSF-fit magnitude of second closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagh3", "default": null, "doc": "H-band PSF-fit magnitude of third closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagk1", "default": null, "doc": "Ks-band PSF-fit magnitude of closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 99.0 otherwise"}, {"type": ["float", "null"], "name": "tmmagk2", "default": null, "doc": "Ks-band PSF-fit magnitude of second closest source from 2MASS catalog; if exists within 60 arcsec [mag]; defaults to 9